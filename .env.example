# Copiar este archivo como `.env` y ajustar los valores. `.env` NO se versiona.

# Clave secreta de Django. Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-esta-clave-en-cada-entorno

# True solo en desarrollo local.
DEBUG=True

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Motor: postgresql (por defecto) o sqlite (solo para pruebas rápidas).
DB_ENGINE=postgresql
DB_NAME=via_coinogas
DB_USER=postgres
DB_PASSWORD=coinogas123
DB_HOST=localhost
DB_PORT=5432

# --- Correo (HU-19: aviso al área de compras) ---
# Si EMAIL_HOST está vacío, los correos se imprimen en consola (desarrollo local).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=VIA Compras <no-reply@coinogas.com>

# Buzones del área de compras, separados por coma. Sin destinatarios no se envía
# el aviso (la radicación funciona igual y queda registrada en el log).
COMPRAS_EMAILS=compras@coinogas.com
