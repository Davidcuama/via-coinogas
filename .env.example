# Copiar este archivo como `.env` y ajustar los valores. `.env` NO se versiona.

# Clave secreta de Django. Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-esta-clave-en-cada-entorno

# True solo en desarrollo local. En el servidor: DEBUG=False.
DEBUG=True

# Hosts permitidos, separados por coma. En el servidor, el dominio del sitio.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Producción (ver despliegue/README.md) ---
# Activa las cookies seguras, la redirección a HTTPS y HSTS. Solo con el
# certificado ya instalado; en desarrollo local se deja en False.
USAR_HTTPS=False
# Orígenes desde los que se aceptan formularios, con https:// incluido. Sin esto,
# detrás de HTTPS todo formulario (incluido el ingreso) falla con 403 de CSRF.
# Ej.: CSRF_TRUSTED_ORIGINS=https://via.ejemplo.com
CSRF_TRUSTED_ORIGINS=
# Cuánto recuerda el navegador que el sitio va solo por HTTPS, en segundos.
# Arranca en una hora; se sube cuando el despliegue esté estable.
SECURE_HSTS_SECONDS=3600
# Carpetas de estáticos (collectstatic) y de adjuntos (HU-11). Opcionales: por
# defecto, staticfiles/ y media/ dentro del proyecto.
# STATIC_ROOT=/srv/via-compras/staticfiles
# MEDIA_ROOT=/srv/via-compras/media

# Base de datos. Motor: postgresql (por defecto) o sqlite (solo para pruebas rápidas).
DB_ENGINE=postgresql
DB_NAME=via_coinogas
DB_USER=postgres
DB_PASSWORD=coinogas123
DB_HOST=localhost
DB_PORT=5432

# --- Correo (HU-19: aviso al área de compras) ---
# Si EMAIL_HOST está vacío, los correos se imprimen en consola (desarrollo local).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=VIA Compras <no-reply@coinogas.com>

# Buzones del área de compras, separados por coma. Sin destinatarios no se envía
# el aviso (la radicación funciona igual y queda registrada en el log).
COMPRAS_EMAILS=compras@coinogas.com
